# PostCraft — AI Post, Image & Email Studio
# Copy to .env and fill with your keys (never commit .env)
# Get keys at:
# - Gemini: https://aistudio.google.com/app/apikey
# - Serper: https://serper.dev
# - HuggingFace: https://huggingface.co/settings/tokens (for fal-ai)
# - Groq: https://console.groq.com/keys

GOOGLE_API_KEY="replace-with-your-gemini-api-key"
SERPER_API_KEY="replace-with-your-api-key"
HF_TOKEN="hf_...your_hf_token_here"
GROQ_API_KEY="gsk_...your_groq_key_here"

# Optional (not used in current flow)
BROWSERBASE_API_KEY="bb_live_...optional"
